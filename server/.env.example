# MongoDB connection string, including the database name
DB=mongodb+srv://<user>:<password>@<cluster-host>/sg-handyman-booking?retryWrites=true&w=majority

# Secret that signs the express-session cookie. Use a long random string.
SECRET=change-me

# OneMap API credentials (https://www.onemap.gov.sg/apidocs/register)
# The server auto-fetches and refreshes the access token using these credentials.
# Tokens are valid for 72 hours; no manual renewal is needed.
ONEMAP_API_EMAIL=your_onemap_email@example.com
ONEMAP_API_PASSWORD=your_onemap_password
ONEMAP_BASE_URL=https://www.onemap.gov.sg

# Optional. Defaults shown.
# PORT=8000
# CLIENT_ORIGIN=http://localhost:5173  (only needed when the client calls the API cross-origin)
