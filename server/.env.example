# MongoDB connection string, including the database name
DB=mongodb+srv://<user>:<password>@<cluster-host>/sg-handyman-booking?retryWrites=true&w=majority

# Separate database for `pnpm --dir server test:timeslots`. Those tests DELETE its data.
# Use the DB string with a database name that ends in _test.
TEST_DB=mongodb+srv://<user>:<password>@<cluster-host>/sg-handyman_test?retryWrites=true&w=majority

# Secret that signs the express-session cookie. Use a long random string.
SECRET=change-me

# OneMap account credentials. The server renews the shared token automatically.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

# Optional. Defaults shown.
# PORT=8000
# CLIENT_ORIGIN=http://localhost:5173  (only needed when the client calls the API cross-origin)
